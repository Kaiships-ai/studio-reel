[tmv_forbid]
# Not ours to sell in the paid TMV kit (spec section 4.1): Anthropic's mascot, Mixkit sounds, Apple's say voice,
# Microsoft's online voice, Kai's likeness, third-party IP from the roles files. Ignoring case, names and text.
clawd
mixkit
# `say -v <voice>` narrates with Apple's voice; `say -v '?'` (line-editing's read-aloud check lists voices) is allowed
make_vo_local|\bsay -v(?! *'\?')
edge.tts
kai-v3|blocky.kai|char-kai
ninjago|daymond
# never ship a buyer's or our Gemini key: a .env file, or a key string in any file
(^|/)\.env$
AIza[0-9A-Za-z_-]{35}

[tmv_exclude]
# Starter files the paid TMV kit leaves out (globs). Kai's house style and everything built on it:
styles/kai-hand-draw/
# but its presenter, which `episode/make.mjs styles` draws the buyer's character with
!styles/kai-hand-draw/engine/core.js
!styles/kai-hand-draw/engine/kaip.js
# and the two hand-lettered fonts the hand-draw episode's cards and captions use
!styles/kai-hand-draw/engine/fonts/PermanentMarker-Regular.ttf
!styles/kai-hand-draw/engine/fonts/LICENSE-PermanentMarker.txt
!styles/kai-hand-draw/engine/fonts/ShantellSans.ttf
!styles/kai-hand-draw/engine/fonts/OFL-ShantellSans.txt
kit/check-reel/
.claude/skills/make-reel/
# Clawd or a voice that is not ours; back in slice 7 with the seeded mascot and Kokoro
styles/living-screencast/
styles/paper-lantern/
styles/game-show/
core/tts/tts_zh.py
