styles/stick-man/engine/play.js :: (import \{ planShots \} from '\./shotplan\.js';) :: $1\nconst noHandCamera = () => { throw new Error('reel.js "direct" (hand-placed cameras) is not in this kit: the auto camera plans every line; steer it with storyboard "role" or "shot"'); };
styles/stick-man/faces.html :: the default s2\n// \(engine/facestyles/s2\.js\), or \?style=kit for every kit expression \(engine/faces\.js\)\. :: every kit expression\n// (engine/faces.js).
