# kit.manifest: the only list of what ships. release/build.mjs reads it; nothing else lists files.
# Every tracked file must match exactly one of [starter], [pro], [dev] (the build fails otherwise, so a new file
# cannot slip into a zip unnoticed). Patterns: `*` = any characters but /, `**` = any path, a trailing / = folder.
# The first matching section wins, sections are tried in the order [dev], [pro], [starter].
# Starter ships [starter]; Pro ships [starter] + [pro]. [forbid] = regexes that must not appear in any shipped text file
# (LICENSE and THIRD_PARTY_NOTICES.md are exempt, they carry the credits on purpose).
# [identity] = regexes, ignoring case, that must not appear in any shipped file at all, binaries and those two included:
# what would lead a buyer from the zip to this repository.
# [vendored] = globs (paths inside the zip) of third-party files shipped verbatim: the English-only buyer-doc check skips
# them, every other check still applies.

[dev]
.claude/CLAUDE.md
.claude/skills/verify/
.claude/worktrees/
.github/
.githooks/
test/
tools/
release/
styleboard/
docs/
.agents/
kaiships/
KAISHIPS.md
kit.manifest
# Kai's own likeness: kept for Kai's films, never shipped (buyers design their own presenter)
styles/kai-hand-draw/engine/kai-v3.js
# Kai's 3D reels (Blocky Kai, casting book with real people and franchise nods): Kai's own use only
styles/kai-reel-3d/
.claude/skills/make-reel-3d/
AGENT_LEARNING.md
PLAN.md
# The paid TMV kit's own files: tmv/<path> replaces or adds <path> in the tmv zip only
tmv/
# Ep1 parts copied read-only from the Pro (no Mixkit, no char-kai, no Clawd cast): port source for slice 3, never shipped as is
dev/

[pro]
.claude/skills/ig-plan/
.claude/skills/ig-reel/
.claude/skills/ig-human/
.claude/skills/ig-viral/
.claude/skills/ig-dm/
.claude/skills/ig-caption/

[starter]
README.md
LICENSE
THIRD_PARTY_NOTICES.md
CHANGELOG.md
AGENTS.md
CLAUDE.md
DIRECTOR.md
TECHNIQUE.md
MY-STYLES.md
product.json
package.json
package-lock.json
pixi.toml
pixi.lock
.gitignore
character-designer.html
.claude/settings.json
.claude/skills/studio/
.claude/skills/make-reel/
kit/
core/
styles/
workspace/
content-types/

[forbid]
kienbeovl
/Users/
kaiship-business
ksa-
hermes-mac
tail9adca5
polar_product_id
plugin/skills/lemo-opuscar
sh core/render/mux\.sh
kai-reel-3d
OpenMontage

[identity]
kaiships-ai
studio-reel
kinebeo

[tmv_forbid]
# Not ours to sell in the paid TMV kit (spec section 4.1): Anthropic's mascot, Mixkit sounds, Apple's say voice,
# Microsoft's online voice, Kai's likeness, third-party IP from the roles files. Ignoring case, names and text.
clawd
mixkit
# `say -v <voice>` narrates with Apple's voice; `say -v '?'` (line-editing's read-aloud check lists voices) is allowed
make_vo_local|\bsay -v(?! *'\?')
edge.tts
kai-v3|blocky.kai|char-kai
ninjago|daymond
# never ship a buyer's or our Gemini key: a .env file, or a key string in any file
(^|/)\.env$
AIza[0-9A-Za-z_-]{35}

[tmv_exclude]
# Starter files the paid TMV kit leaves out (globs). Kai's house style and everything built on it:
styles/kai-hand-draw/
# but its presenter, which `episode/make.mjs styles` draws the buyer's character with
!styles/kai-hand-draw/engine/core.js
!styles/kai-hand-draw/engine/kaip.js
kit/check-reel/
.claude/skills/make-reel/
# Clawd or a voice that is not ours; back in slice 7 with the seeded mascot and Kokoro
styles/living-screencast/
styles/paper-lantern/
styles/game-show/
core/tts/tts_zh.py
# Starter docs that describe the house style; the TMV kit has its own in tmv/
CHANGELOG.md
DIRECTOR.md
TECHNIQUE.md
MY-STYLES.md
character-designer.html
core/README.md
workspace/README.md
content-types/

[vendored]
# story-skills 0.24.1 by Daniel Dewhurst (MIT), from tmv/.claude/skills/
