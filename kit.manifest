styles/stick-man/engine/look.js :: uImpact, uWhip, uShadowK, uShoulder, uGrain, uSoft, uTime; uniform vec3 uTint, uShadowC; uniform vec2 uImpC, uBlur, texel; :: uImpact, uWhip; uniform vec3 uTint; uniform vec2 uImpC, texel;
styles/stick-man/engine/look.js :: \n        // motion blur on a very fast camera move only[\s\S]*?c = mix\(c, b, uSoft\); \} :: 
