styles/stick-man/engine/look.js :: \n        if \(uGrain > 0\.0\)[^\n]* :: 
styles/stick-man/engine/look.js :: const gr = o\.grade \|\| \{\}; if \(stage\.shafts\)[^\n]* :: const gr = {};
styles/stick-man/engine/look.js :: \n    const U = gradePass\.uniforms, sc = gr\.shadow;[^\n]*\n    U\.uShoulder\.value[^\n]* :: 
