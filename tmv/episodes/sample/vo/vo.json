   "e": 6.469
  },
  {
   "id": "b03",
   "who": "nova",
   "text": "His app does half of what mine does.",
   "s": 6.789,
   "e": 8.569
  },
  {
   "id": "b04",
   "who": "blip",
   "text": "Beep. People don't share apps. They share stories.",
   "s": 8.889,
   "e": 11.11
  },
  {
   "id": "b05",
   "who": "nova",
   "text": "So I show the bug that almost killed it?",
