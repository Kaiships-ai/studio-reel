{
 "duration": 38.506,
 "lines": [
  {
   "id": "b01",
   "who": "nova",
   "text": "Nova shipped her app today. Two hundred views.",
   "s": 0.25,
   "e": 3.138
  },
  {
   "id": "b02",
   "who": "theo",
   "text": "Across town, Theo's launch ad hit forty thousand by lunch.",
   "s": 3.458,
   "e": 7.008
  },
  {
   "id": "b03",
   "who": "nova",
   "text": "His app does half of what hers does.",
   "s": 7.328,
   "e": 9.368
  },
  {
   "id": "b04",
   "who": "theo",
   "text": "Theo just grins. Views are views, he says. Speed wins.",
   "s": 9.688,
   "e": 13.394
  },
  {
   "id": "b05",
   "who": "blip",
   "text": "Then Blip beeps. People don't share apps. They share stories.",
   "s": 13.714,
   "e": 17.61
  },
  {
   "id": "b06",
   "who": "nova",
   "text": "So her story is the bug that almost killed it?",
   "s": 17.93,
   "e": 20.25
  },
  {
   "id": "b07",
   "who": "theo",
   "text": "Theo says post a clean demo. Nobody cares about bugs.",
   "s": 20.57,
   "e": 23.728
  },
  {
   "id": "b08",
   "who": "nova",
   "text": "Three nights. One bug. Nova almost quit.",
   "s": 24.048,
   "e": 27.254
  },
  {
   "id": "b09",
   "who": "blip",
   "text": "Blip is sure. That is the story. Show the night she almost quit.",
   "s": 27.574,
   "e": 31.4
  },
  {
   "id": "b10",
   "who": "blip",
   "text": "One post tonight. Tomorrow, they count.",
   "s": 31.72,
   "e": 34.056
  },
  {
   "id": "b11",
   "who": "nova",
   "text": "Comment A for the demo, or B for the story.",
   "s": 34.376,
   "e": 38.186
  }
 ],
