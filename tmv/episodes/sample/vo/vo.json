   "id": "b01",
   "who": "nova",
   "text": "I shipped my app today. Two hundred views.",
   "s": 0.25,
   "e": 2.676
  },
  {
   "id": "b02",
   "who": "rook",
   "text": "Two hundred? My launch ad hit forty thousand by lunch.",
