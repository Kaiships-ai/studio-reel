{
 "duration": 30.418,
 "lines": [
  {
   "id": "b01",
   "who": "nova",
   "text": "I shipped my app today. Two hundred views.",
   "s": 0.25,
   "e": 2.676
  },
  {
   "id": "b02",
   "who": "theo",
   "text": "Two hundred? My launch ad hit forty thousand by lunch.",
   "s": 2.996,
   "e": 6.469
  },
  {
   "id": "b03",
   "who": "nova",
   "text": "His app does half of what mine does.",
   "s": 6.789,
   "e": 8.569
  },
  {
   "id": "b04",
   "who": "theo",
   "text": "Views are views, Nova. Speed wins.",
   "s": 8.889,
   "e": 11.174
  },
  {
   "id": "b05",
   "who": "blip",
   "text": "Beep. People don't share apps. They share stories.",
   "s": 11.494,
   "e": 13.715
  },
  {
   "id": "b06",
   "who": "nova",
   "text": "So my story is the bug that almost killed it?",
   "s": 14.035,
   "e": 16.359
  },
  {
   "id": "b07",
   "who": "theo",
   "text": "Or post a clean demo. Nobody cares about your bugs.",
   "s": 16.679,
   "e": 20.26
  },
  {
   "id": "b08",
   "who": "nova",
   "text": "Three nights. One bug. I almost quit.",
   "s": 20.58,
   "e": 22.761
  },
  {
   "id": "b09",
   "who": "blip",
   "text": "That is the story. Show the night you almost quit.",
   "s": 23.081,
   "e": 25.271
  },
  {
   "id": "b10",
   "who": "blip",
   "text": "One post tonight. Tomorrow, we count.",
   "s": 25.591,
   "e": 27.42
  },
  {
   "id": "b11",
   "who": "nova",
   "text": "Comment A for the demo, or B for the story.",
   "s": 27.74,
   "e": 30.098
  }
 ],
